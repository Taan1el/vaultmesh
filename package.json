{
  "name": "vaultmesh",
  "version": "1.0.0",
  "description": "Local secrets manager with envelope encryption, Shamir threshold unseal, key rotation and dynamic leases",
  "private": true,
  "type": "module",
  "homepage": "https://taan1el.github.io/vaultmesh/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Taan1el/vaultmesh.git"
  },
  "bugs": {
    "url": "https://github.com/Taan1el/vaultmesh/issues"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build:pages": "npm run build:pages --workspace=client",
    "test": "npm run test:server && npm run test:client",
    "test:e2e": "playwright test",
    "screenshots:e2e": "cross-env UPDATE_SCREENSHOTS=1 playwright test tests/e2e/vault-workflow.spec.ts --project=chromium",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "lint": "npm run lint:server && npm run lint:client",
    "lint:server": "npm run lint --workspace=server",
    "lint:client": "npm run lint --workspace=client"
  },
  "keywords": [
    "secrets-manager",
    "kms",
    "envelope-encryption",
    "aes-256-gcm",
    "key-rotation",
    "shamir-secret-sharing",
    "dynamic-leases",
    "tamper-evident-audit",
    "react19",
    "sqlite-wal"
  ],
  "author": "Taaniel Vananurm",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "cross-env": "^10.1.0"
  }
}
