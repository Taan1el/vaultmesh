# Copy to .env and adjust as needed. The server reads these from the
# process environment; nothing loads this file automatically, so either
# export the values yourself or run Node with --env-file, for example:
#   node --env-file=.env dist/server/src/index.js

# Port the Express API listens on.
PORT=4005

# Interface to bind. The API has no authentication, so it only binds to
# the loopback interface unless this is set to something else.
HOST=127.0.0.1

# Where the SQLite database file is stored. Defaults to data/vaultmesh.db
# inside the server package.
VAULTMESH_DB_PATH=./data/vaultmesh.db
